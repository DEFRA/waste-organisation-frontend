{% extends 'layouts/page.njk' %}
{% from "govuk/components/table/macro.njk" import govukTable %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% include "partials/cookie-settings-confirmation.njk" %}

      <h1 class="govuk-heading-l">Cwcis</h1>

      <p class="govuk-body">
        Mae'r gwasanaeth hwn yn rhoi ffeiliau bach (a elwir yn gwcis) ar eich
        cyfrifiadur. Mae'r cwcis hyn yn cael eu defnyddio i wneud i'r gwasanaeth
        weithio ac ni ellir eu diffodd.
      </p>

      {# Analytics accept/reject form (English copy for now), shared with the English page. #}
      {% include "partials/cookie-settings.njk" %}

      <h2 class="govuk-heading-m">Cwcis hanfodol</h2>

      <p class="govuk-body">
        Mae cwcis hanfodol yn cadw'ch gwybodaeth yn ddiogel wrth ichi
        ddefnyddio'r gwasanaeth hwn. Nid oes angen inni ofyn am ganiatâd i'w
        defnyddio.
      </p>

      {%
        set cookieRows = [
          [
            { text: 'userSession' },
            { text: 'Yn eich cadw chi wedi mewngofnodi' },
            { text: '4 awr' }
          ],
          [
            { text: 'session' },
            { text: 'Yn storio data sesiwn' },
            { text: '4 awr' }
          ],
          [
            { text: 'bell-defraId' },
            { text: 'Yn cael ei ddefnyddio i fewngofnodi gydag ID' },
            { text: "fyddwch chi'n cau'ch porwr" }
          ]
        ]
      %}
      {%
        set langCookieRow = [[
          { text: 'lang' },
          { text: "Yn cofio'ch dewis iaith" },
          { text: '400 diwrnod' }
        ]]
      %}
      {# Only set once the banner or settings form records a choice. English copy for now. #}
      {% set consentCookie = layout.cookieSettings.consentCookie %}
      {%
        set consentCookieRow = [[
          { text: consentCookie.name },
          { text: consentCookie.purpose },
          { text: consentCookie.expires }
        ]]
      %}

      {{
        govukTable({
          attributes: { "data-cookie-table": "essential" },
          head: [{ text: 'Enw' }, { text: 'Pwrpas' }, { text: 'Yn dod i ben' }],
          rows: cookieRows
            .concat(welshLanguage and langCookieRow or [])
            .concat(googleAnalytics and consentCookieRow or [])
        })
      }}
    </div>
  </div>
{% endblock %}
